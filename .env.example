# ---------------------------------------------------------------------------
# Public site configuration
# ---------------------------------------------------------------------------
# Canonical production URL. Used for metadata, canonical tags, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://lennartkits.vercel.app

# ---------------------------------------------------------------------------
# Contact form delivery (server-side only — never exposed to the browser)
# ---------------------------------------------------------------------------
# Where contact form submissions are delivered.
CONTACT_EMAIL_TO=lennartkitssoletrader@gmail.com

# Transactional email provider (Resend: https://resend.com).
# If RESEND_API_KEY is not set, the contact form stays available but tells the
# visitor to email the business address directly instead of silently failing.
RESEND_API_KEY=
# Must be an address on a domain verified in your Resend account. A
# *.vercel.app deployment domain cannot be verified for sending, so this needs
# a domain you own; leave it empty until one is verified.
RESEND_FROM=
